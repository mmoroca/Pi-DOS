# First image: keep the Pi defconfig hardware baseline, make essentials built-in.
# CONFIG_MODULES is not set
CONFIG_ARM64_4K_PAGES=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_INPUT_EVDEV=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
CONFIG_DRM_LOAD_EDID_FIRMWARE=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_HDMI_CODEC=y
CONFIG_SND_USB_AUDIO=y
CONFIG_UNIX=y
# Keep netlink for libudev-zero; no IP stack or network interfaces.
CONFIG_NET=y
# CONFIG_INET is not set
# CONFIG_IPV6 is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_RFKILL is not set
# CONFIG_KVM is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_LOGO is not set
# Distribution defconfig modules become built-ins when MODULES is disabled.
# Exclude unrelated top-level groups rather than embedding camera/TV drivers
# and general-purpose filesystems in the appliance kernel.
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_STAGING is not set
# CONFIG_IIO is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_BCACHEFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_NTFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_BINFMT_MISC is not set
CONFIG_LOCALVERSION="-armdos-pi5"
# CONFIG_LOCALVERSION_AUTO is not set
