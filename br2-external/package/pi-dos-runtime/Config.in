config BR2_PACKAGE_PI_DOS_RUNTIME
	bool "pi-dos-runtime"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_SDL2
	depends on BR2_PACKAGE_ALSA_LIB
	depends on BR2_PACKAGE_FLUIDSYNTH
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_UTIL_LINUX
	select BR2_PACKAGE_UTIL_LINUX_LIBBLKID
	select BR2_PACKAGE_DOSFSTOOLS
	select BR2_PACKAGE_DOSFSTOOLS_FATLABEL
	select BR2_PACKAGE_EXFATPROGS
	select BR2_PACKAGE_SDL2_NET
	select BR2_PACKAGE_SLIRP
	select BR2_PACKAGE_LIBPCAP
	select BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY if BR2_TOOLCHAIN_USES_GLIBC
	select BR2_PACKAGE_ALSA_LIB_SEQ
	help
	  Pinned DOSBox-X-derived SDL2 runtime with Pi-DOS patches.
