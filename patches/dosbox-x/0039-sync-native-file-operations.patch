+static bool PiDosSyncParent(const char *path) {
+    std::string parent(path);
+    const auto slash = parent.find_last_of('/');
+    parent = slash == std::string::npos ? "." : parent.substr(0, slash ? slash : 1);
+    const int fd = open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (fd < 0) return PiDosAttributeError();
+    const int result = fsync(fd), error = errno;
+    const int closed = close(fd);
+    if (result) errno = error;
+    return (!result && !closed) || PiDosAttributeError();
 }
