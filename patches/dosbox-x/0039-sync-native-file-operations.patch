+// DOS flush and final close commit data and metadata on native FAT volumes.
+bool LocalFile::SyncNative() {
+#if defined(LINUX)
+    if (!native_dos_attributes) return true;
+    if (native_sync_failed) { errno = EIO; return PiDosAttributeError(); }
+    if (!fhandle) return true;
+    bool ok = fflush(fhandle) == 0;
+    if (ferror(fhandle)) { errno = EIO; ok = false; }
+    if (ok && native_written) {
+        uint16_t attributes = 0;
+        ok = pidos_attributes::get(fileno(fhandle), attributes);
+        if (ok && !(attributes & DOS_ATTR_ARCHIVE))
+            ok = pidos_attributes::set(fileno(fhandle), uint16_t(attributes | DOS_ATTR_ARCHIVE));
+        if (ok) attr = uint16_t(attributes | DOS_ATTR_ARCHIVE);
+    }
+    if (ok && (native_written || newtime)) ok = fsync(fileno(fhandle)) == 0;
+    if (!ok) { native_sync_failed = true; return PiDosAttributeError(); }
+#endif
+    return true;
+}
