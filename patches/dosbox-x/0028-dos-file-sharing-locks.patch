+static bool PiDosShareError(int error) {
+    if (!error) return true;
+    DOS_SetError(uint16_t(error)); return false;
+}
+
+static bool PiDosShareKey(uint8_t drive, const char *name, pidos_sharing::Key &key) {
+    char qualified[DOS_PATHLENGTH + 8], short_name[DOS_PATHLENGTH + 8];
+    snprintf(qualified, sizeof(qualified), "\"%c:\\%s\"", 'A' + drive, name);
+    const auto saved_error = dos.errorcode;
+    std::string path = DOS_SharingSFNPath(qualified, short_name) ? short_name + 3 : name;
+    dos.errorcode = saved_error;
+    std::vector<char> normalized(path.begin(), path.end()); normalized.push_back(0);
+    DBCS_upcase(normalized.data());
+    key.path = normalized.data();
+    key.media = Drives[drive] ? Drives[drive]->SharingMediaId() : 0;
+    if (!key.media) { DOS_SetError(DOSERR_DRIVE_NOT_READY); return false; }
+    return true;
+}
+
+static bool PiDosShareCurrent(DOS_File *file) {
+    const auto drive = file->GetDrive();
+    if (drive >= DOS_DRIVES || !Drives[drive] ||
+        Drives[drive]->SharingMediaId() != file->sharing->key.media) {
+        DOS_SetError(DOSERR_DRIVE_NOT_READY); return false;
+    }
+    return file->SharingReady();
+}
+
+static bool PiDosShareAccess(DOS_File *file, uint32_t count, bool write) {
+    if (!DOS_UsesInternalSharing() || !file->sharing) return true;
+    if (!(file->sharing->access & (write ? 2 : 1))) { DOS_SetError(DOSERR_ACCESS_DENIED); return false; }
+    if (!PiDosShareCurrent(file) || !file->SharingRefresh()) return false;
+    if (!enable_share_exe) return true;
+    const uint32_t position = file->GetSeekPos();
+    uint64_t begin = position, end = uint64_t(position) + count;
+    if (write && !count) {
+        uint32_t length = 0;
+        if (!file->Seek(&length, DOS_SEEK_END)) return false;
+        uint32_t restore = position;
+        if (!file->Seek(&restore, DOS_SEEK_SET)) return false;
+        begin = std::min(position, length); end = std::max(position, length);
+    }
+    return PiDosShareError(dos_sharing.access(file->sharing->key, dos.psp(), begin, end));
+}
