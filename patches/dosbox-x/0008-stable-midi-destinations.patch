From: Pi-DOS project
Subject: [PATCH] Stable ALSA MIDI destinations and explicit profile failure

Resolve stable identities at open time. Subscriptions prevent disconnects
from redirecting data to reused client IDs. The package hook installs the
shared port scanner header.

--- a/src/gui/midi.cpp
+++ b/src/gui/midi.cpp
@@ -124,6 +124,7 @@
 
 #if defined (HAVE_ALSA)
 
+#include "pidos_midi_ports.h"
 #include "midi_alsa.h"
 
 #endif
@@ -652,6 +653,14 @@
 				LOG_MSG("MIDI:Cannot open device:%s with config:%s. Finding default handler.",dev,conf);
 		}
 
+        /* Managed Pi-DOS profiles must never fall back to a different synth. */
+        const char *managed = getenv("PI_DOS_MIDI_MANAGED");
+        if (!opened && managed && !strcmp(managed, "1")) {
+            LOG_MSG("Pi-DOS: selected MIDI output unavailable; MIDI disabled");
+            for (handler = handler_list; handler; handler = handler->next) {
+                if (!strcmp(handler->GetName(), "none")) { opened = handler->Open(""); break; }
+            }
+        }
 		if (!opened) {
 			for (handler = handler_list; handler; handler = handler->next) {
 				opened = handler->Open(conf);
--- a/src/gui/midi_alsa.h
+++ b/src/gui/midi_alsa.h
@@ -46,6 +46,7 @@
 	snd_seq_t *seq_handle;
 	alsa_address seq = {-1, -1}; // address of input port we're connected to
 	int seq_client, seq_port;
+    bool pidos_destination = false;
 	int my_client, my_port;
 
     using port_action_t = std::function<void(snd_seq_client_info_t *client_info, snd_seq_port_info_t *port_info)>;
@@ -90,7 +91,8 @@
     void send_event(int do_flush) {
 		snd_seq_ev_set_direct(&ev);
 		snd_seq_ev_set_source(&ev, my_port);
-		snd_seq_ev_set_dest(&ev, seq_client, seq_port);
+		if (pidos_destination) snd_seq_ev_set_subs(&ev);
+        else snd_seq_ev_set_dest(&ev, seq_client, seq_port);
 
 		snd_seq_event_output(seq_handle, &ev);
 		if (do_flush)
@@ -242,11 +244,16 @@
 
+        pidos_destination = conf && !strncmp(conf, "pidos:", 6);
 		// try to use port specified in config file
 		if (conf && conf[0]) { 
-			safe_strncpy(var, conf, 10);
-			if (!parse_addr(var, &seq_client, &seq_port)) {
-				LOG(LOG_MISC,LOG_WARN)("ALSA:Invalid alsa port %s", var);
-				return false;
-			}
+            if (pidos_destination) {
+                if (!pidos_midi_resolve(conf, &seq_client, &seq_port)) {
+                    LOG_MSG("Pi-DOS: USB MIDI destination missing or ambiguous");
+                    return false;
+                }
+            } else {
+                safe_strncpy(var, conf, 10);
+                if (!parse_addr(var, &seq_client, &seq_port)) return false;
+            }
 			defaultport = false;
 		}
 		// default port if none specified
@@ -271,7 +278,7 @@
 		snd_seq_set_client_group(seq_handle, "input");
 	
 		caps = SND_SEQ_PORT_CAP_READ;
-		if (seq_client == SND_SEQ_ADDRESS_SUBSCRIBERS)
+		if (seq_client == SND_SEQ_ADDRESS_SUBSCRIBERS || pidos_destination)
 			caps |= SND_SEQ_PORT_CAP_SUBS_READ;
 		my_port = snd_seq_create_simple_port(seq_handle, "DOSBOX-X", caps, SND_SEQ_PORT_TYPE_MIDI_GENERIC | SND_SEQ_PORT_TYPE_APPLICATION);
 		if (my_port < 0) {
@@ -305,26 +312,14 @@
 		return true;
 	}
 
+    static void ListPiDosPort(const PiDosMidiPort *port, void *data) {
+        Program *base = static_cast<Program *>(data);
+        base->WriteOut("  %3d:%d - %s\n", port->client, port->port, port->label);
+        base->WriteOut("@PIDOSMIDI %s\t%s\n", port->id, port->label);
+    }
     void ListAll(Program* base) override {
-#if __cplusplus <= 201103L // C++11 compliant code not tested
-        auto print_port = [base, this](snd_seq_client_info_t *client_info, snd_seq_port_info_t *port_info) {
-            const auto* addr = snd_seq_port_info_get_addr(port_info);
-            const unsigned int type = snd_seq_port_info_get_type(port_info);
-            const unsigned int caps = snd_seq_port_info_get_capability(port_info);
-#else
-        auto print_port = [base, this](auto* client_info, auto* port_info) {
-            const auto* addr = snd_seq_port_info_get_addr(port_info);
-            const unsigned int type = snd_seq_port_info_get_type(port_info);
-            const unsigned int caps = snd_seq_port_info_get_capability(port_info);
-#endif
-            if ((type & SND_SEQ_PORT_TYPE_SYNTHESIZER) || port_is_writable(caps)) {
-                const bool selected = (addr->client == this->seq.client && addr->port == this->seq.port);
-                const char esc_color[] = "\033[32;1m";
-                const char esc_nocolor[] = "\033[0m";
-                base->WriteOut("%c %s%3d:%d - %s - %s%s\n", selected?'*':' ', selected?esc_color : "", addr->client, addr->port, snd_seq_client_info_get_name(client_info), snd_seq_port_info_get_name(port_info), selected?esc_nocolor:"");
-            }
-        };
-        for_each_alsa_seq_port(print_port);
+        if (pidos_midi_ports(ListPiDosPort, base) < 0)
+            base->WriteOut("Pi-DOS: ALSA MIDI sequencer unavailable\n");
     }
 
 };
