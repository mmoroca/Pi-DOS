     if (GFX_IsFullscreen()) {
-        SDL_DisplayMode displayMode;
-        SDL_GetWindowDisplayMode(sdl.window, &displayMode);
-
-        displayMode.w = width;
-        displayMode.h = height;
-        SDL_SetWindowDisplayMode(sdl.window, &displayMode);
-
-        SDL_SetWindowFullscreen(sdl.window, flags);
+        SDL_DisplayMode displayMode = {};
+        if (kms_modeswitch) {
+            const int display = SDL_GetWindowDisplayIndex(sdl.window);
+            SDL_DisplayMode target = {};
+            target.w = width;
+            target.h = height;
+            target.refresh_rate = render.src.fps > 0 ?
+                (int)floor(render.src.fps + 0.5) : 0;
+            const int count = SDL_GetNumDisplayModes(display);
+            static bool logged_modes = false;
+            bool matched = false;
+            double best_distance = 1e9;
+            for (int i = 0; i < count; ++i) {
+                SDL_DisplayMode candidate = {};
+                if (SDL_GetDisplayMode(display, i, &candidate) != 0)
+                    continue;
+                if (!logged_modes)
+                    LOG_MSG("Pi-DOS video available: %dx%d@%d",
+                            candidate.w, candidate.h, candidate.refresh_rate);
+                if (candidate.w != target.w || candidate.h != target.h)
+                    continue;
+                const double distance = candidate.refresh_rate > 0 ?
+                    fabs(candidate.refresh_rate - render.src.fps) : 1e8;
+                if (!matched || distance < best_distance) {
+                    displayMode = candidate;
+                    best_distance = distance;
+                    matched = true;
+                }
+            }
+            logged_modes = true;
+            if (!matched && !SDL_GetClosestDisplayMode(display, &target, &displayMode)) {
+                LOG_MSG("Pi-DOS video: no host mode for %dx%d@%d: %s",
+                        target.w, target.h, target.refresh_rate, SDL_GetError());
+                return sdl.window;
+            }
+            LOG_MSG("Pi-DOS video request: guest=%ux%u@%.3f rendered=%ux%u selected=%dx%d@%d%s",
+                    (unsigned)vga.draw.width, (unsigned)vga.draw.height,
+                    (double)render.src.fps, (unsigned)width, (unsigned)height,
+                    displayMode.w, displayMode.h, displayMode.refresh_rate,
+                    matched ? "" : " (resolution fallback)");
+            pi_dos_video_audit_pending = true;
+        } else {
+            SDL_GetWindowDisplayMode(sdl.window, &displayMode);
+            displayMode.w = width;
+            displayMode.h = height;
+        }
+        if (SDL_SetWindowDisplayMode(sdl.window, &displayMode) != 0)
+            LOG_MSG("SDL: failed to set display mode: %s", SDL_GetError());
+        if (SDL_SetWindowFullscreen(sdl.window, flags) != 0)
+            LOG_MSG("SDL: failed to enter fullscreen: %s", SDL_GetError());
     } else {
         SDL_SetWindowFullscreen(sdl.window, 0);
 
