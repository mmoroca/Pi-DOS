Pi-DOS: Keep fullscreen mouse capture across guest video mode changes.

Windows 3.x consumes relative PS/2 motion, which is sent only while captured.
The SDL2 surface path toggled capture on every CRT mode change; LCD's early
return omitted capture. Set capture explicitly, including the startup call,
so text setup and the Windows desktop keep receiving relative motion.

--- a/src/gui/sdlmain.cpp
+++ b/src/gui/sdlmain.cpp
@@ -9816,7 +9816,7 @@
                 if (!sdl.desktop.fullscreen) GFX_SwitchFullScreen();
 
                 /* Setup Mouse correctly if fullscreen */
-                if(sdl.desktop.fullscreen&&sdl.mouse.autoenable) GFX_CaptureMouse();
+                if(sdl.desktop.fullscreen&&sdl.mouse.autoenable) GFX_CaptureMouse(true);
             }
 
             // Shows menu bar (window)
--- a/src/output/output_surface.cpp
+++ b/src/output/output_surface.cpp
@@ -97,6 +97,7 @@
         sdl.deferred_resize = false;
         sdl.must_redraw_all = true;
         SDL_FillRect(sdl.surface, nullptr, SDL_MapRGB(sdl.surface->format, 0, 0, 0));
+        GFX_CaptureMouse(true);
         return GFX_CAN_32;
     }
     Bitu bpp = 0;
@@ -121,8 +122,8 @@
             sdl.window = GFX_SetSDLWindowMode(sdl.draw.width, sdl.draw.height, SCREEN_SURFACE);
             if (sdl.window == NULL)
                 LOG_MSG("Fullscreen not supported: %s", SDL_GetError());
-            GFX_CaptureMouse();
-        }
+        }
+        GFX_CaptureMouse(true);
     }
     else {
         int width = sdl.draw.width;
