+
+// A missing disk/disc is an I/O error, not an empty directory. Probe the
+// root before pathname expansion, which can otherwise replace the DOS error.
+static bool PiDosShellMediaReady(DOS_Shell *shell, const char *path) {
+    if (!PiDosApplianceDrives()) return true;
+    while (*path == ' ' || *path == '\t' || *path == '"') ++path;
+    unsigned int drive = DOS_GetDefaultDrive();
+    if (*path && path[1] == ':') {
+        const unsigned char letter = static_cast<unsigned char>(*path);
+        if (!isalpha(letter)) return true;
+        drive = static_cast<unsigned int>(toupper(letter) - 'A');
+    }
+    if (drive >= DOS_DRIVES || !Drives[drive]) return true;
+    const auto previous_error = dos.errorcode;
+    DOS_SetError(0);
+    const bool ready = Drives[drive]->TestDir("");
+    if (!ready && dos.errorcode == DOSERR_DRIVE_NOT_READY) {
+        shell->WriteOut("Not ready reading drive %c\n", static_cast<int>('A' + drive));
+        dos.return_code = 1;
+        return false;
+    }
+    DOS_SetError(previous_error);
+    return true;
+}
 
