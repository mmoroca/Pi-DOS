@@ -52,8 +55,34 @@
 }
 
 #if defined(C_SDL2)
+static SDL_Surface *pidos_lcd_surface = nullptr;
 Bitu OUTPUT_SURFACE_SetSize()
 {
+    SDL_FreeSurface(pidos_lcd_surface);
+    pidos_lcd_surface = nullptr;
+    if (getenv("PI_DOS_LCD_MODE") && GFX_IsFullscreen()) {
+        sdl.window = GFX_SetSDLWindowMode(sdl.desktop.full.width,
+                                         sdl.desktop.full.height, SCREEN_SURFACE);
+        if (!sdl.window) E_Exit("Pi-DOS LCD window unavailable");
+        sdl.surface = SDL_GetWindowSurface(sdl.window);
+        if (!sdl.surface) E_Exit("Pi-DOS LCD surface: %s", SDL_GetError());
+        pidos_lcd_surface = SDL_CreateRGBSurfaceWithFormat(0, sdl.draw.width,
+                            sdl.draw.height, 32, SDL_PIXELFORMAT_RGB888);
+        if (!pidos_lcd_surface) E_Exit("Pi-DOS LCD source surface: %s", SDL_GetError());
+        SDL_SetSurfaceBlendMode(pidos_lcd_surface, SDL_BLENDMODE_NONE);
+        const char *aspect = getenv("PI_DOS_LCD_ASPECT");
+        const PidosViewport viewport = pidos_lcd_fit(sdl.surface->w, sdl.surface->h,
+            render.src.width, render.src.height, !aspect || strcmp(aspect, "original"));
+        sdl.clip.x = viewport.x;
+        sdl.clip.y = viewport.y;
+        sdl.clip.w = viewport.w;
+        sdl.clip.h = viewport.h;
+        sdl.window_too_small = false;
+        sdl.deferred_resize = false;
+        sdl.must_redraw_all = true;
+        SDL_FillRect(sdl.surface, nullptr, SDL_MapRGB(sdl.surface->format, 0, 0, 0));
+        return GFX_CAN_32;
+    }
     Bitu bpp = 0;
     Bitu retFlags = 0;
     (void)bpp;
