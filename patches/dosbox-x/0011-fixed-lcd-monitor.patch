Pi-DOS: Present LCD profiles in one fixed SDL2 mode with aspect fitting.

Keep the CRT path unchanged. Software TV/scan effects run before the final
nearest-neighbor fit into a centered 4:3 or original-pixel viewport.

--- a/src/gui/sdlmain.cpp
+++ b/src/gui/sdlmain.cpp
@@ -1800,6 +1800,54 @@
 SDL_Window* GFX_SetSDLWindowMode(uint16_t width, uint16_t height, SCREEN_TYPES screenType)
 {
     static SCREEN_TYPES lastType = SCREEN_SURFACE;
+    /* A managed LCD session keeps one advertised host mode, independently of
+     * guest raster/refresh changes. CRT and unmanaged sessions use the path below. */
+    const char *lcd = getenv("PI_DOS_LCD_MODE");
+    int lcd_width = 0, lcd_height = 0;
+    if (screenType == SCREEN_SURFACE && GFX_IsFullscreen() && lcd &&
+        sscanf(lcd, "%dx%d", &lcd_width, &lcd_height) == 2 &&
+        lcd_width >= 160 && lcd_width <= 4096 && lcd_height >= 100 && lcd_height <= 2160) {
+        if (!sdl.window) {
+            sdl.window = SDL_CreateWindow("Pi-DOS",
+                SDL_WINDOWPOS_UNDEFINED_DISPLAY(sdl.displayNumber ? sdl.displayNumber - 1 : 0),
+                SDL_WINDOWPOS_UNDEFINED_DISPLAY(sdl.displayNumber ? sdl.displayNumber - 1 : 0),
+                lcd_width, lcd_height, SDL_WINDOW_SHOWN);
+            if (!sdl.window) E_Exit("Pi-DOS LCD window: %s", SDL_GetError());
+        }
+        SDL_DisplayMode target = {}, selected = {}, previous = {};
+        target.w = lcd_width;
+        target.h = lcd_height;
+        const int display = SDL_GetWindowDisplayIndex(sdl.window);
+        if (!SDL_GetClosestDisplayMode(display, &target, &selected))
+            E_Exit("Pi-DOS LCD mode %s unavailable: %s", lcd, SDL_GetError());
+        SDL_GetWindowDisplayMode(sdl.window, &previous);
+        /* Refresh zero lets SDL select an advertised rate once; never follow guest fps. */
+        if (previous.w != selected.w || previous.h != selected.h ||
+            previous.refresh_rate != selected.refresh_rate) {
+            if (SDL_SetWindowDisplayMode(sdl.window, &selected) != 0)
+                E_Exit("Pi-DOS LCD display mode: %s", SDL_GetError());
+        }
+        if (!(SDL_GetWindowFlags(sdl.window) & SDL_WINDOW_FULLSCREEN) &&
+            SDL_SetWindowFullscreen(sdl.window, SDL_WINDOW_FULLSCREEN) != 0)
+            E_Exit("Pi-DOS LCD fullscreen: %s", SDL_GetError());
+        int actual_width = 0, actual_height = 0;
+        SDL_GetWindowSize(sdl.window, &actual_width, &actual_height);
+        sdl.surface = SDL_GetWindowSurface(sdl.window);
+        if (!sdl.surface) E_Exit("Pi-DOS LCD surface: %s", SDL_GetError());
+        sdl.window_desired_width = actual_width;
+        sdl.window_desired_height = actual_height;
+        currentWindowWidth = actual_width;
+        currentWindowHeight = actual_height;
+        sdl.update_display_contents = true;
+        lastType = SCREEN_SURFACE;
+        pi_dos_video_audit_pending = pi_dos_video_diagnostics;
+        if (pi_dos_video_diagnostics)
+            LOG_MSG("Pi-DOS LCD request: configured=%s selected=%dx%d@%d guest=%ux%u@%.3f%s",
+                lcd, selected.w, selected.h, selected.refresh_rate,
+                (unsigned)vga.draw.width, (unsigned)vga.draw.height, (double)render.src.fps,
+                selected.w == lcd_width && selected.h == lcd_height ? "" : " (resolution fallback)");
+        return sdl.window;
+    }
     if (sdl.renderer) {
         SDL_DestroyRenderer(sdl.renderer);
         sdl.renderer = nullptr;
