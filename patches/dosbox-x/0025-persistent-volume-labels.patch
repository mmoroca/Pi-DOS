+// All guest label paths use the same checked backend, including FORMAT's
+// extended-FCB create/delete/rename calls.
+bool DOS_SetVolumeLabel(uint8_t drive, const char *label) {
+    if (drive >= DOS_DRIVES || !Drives[drive]) {
+        DOS_SetError(DOSERR_INVALID_DRIVE); return false;
+    }
+    if (PiDosProtectedDrive(drive)) {
+        DOS_SetError(DOSERR_WRITE_PROTECTED); return false;
+    }
+    std::string value(label);
+    while (!value.empty() && value.back() == ' ') value.pop_back();
+    if (value.size() > 11 || (!value.empty() && value.front() == ' ') ||
+        value.find_first_of("*?.,;:/\\|+=<>[]\"") != std::string::npos) {
+        DOS_SetError(DOSERR_DATA_INVALID); return false;
+    }
+    for (const unsigned char c : value) if (c < 32 || c == 127) {
+        DOS_SetError(DOSERR_DATA_INVALID); return false;
+    }
+    char normalized[12] = {};
+    memcpy(normalized, value.c_str(), value.size());
+    DBCS_upcase(normalized);
+    DOS_SetError(0);
+    return Drives[drive]->SetLabelChecked(normalized);
+}
