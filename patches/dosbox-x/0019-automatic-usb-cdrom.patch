+
+// Native optical media are replaceable while the DOS drive stays registered.
+uint64_t isoDrive::USBGeneration() const {
+	return cdrom && cdrom->class_id == CDROM_Interface::ID_USB ? cdrom->MediaGeneration() : 0;
+}
+
+bool isoDrive::USBReady(uint64_t expected) {
+	if (!cdrom || cdrom->class_id != CDROM_Interface::ID_USB) return true;
+	if (usb_loading) return true;
+	bool present = false, changed = false, tray = false;
+	cdrom->GetMediaTrayStatus(present, changed, tray);
+	const uint64_t generation = USBGeneration();
+	if (generation != usb_generation || (present && !usb_ready)) {
+		usb_generation = generation; usb_ready = false;
+		curdir[0] = discLabel[0] = 0;
+#if !defined(OSFREE)
+		nextFreeDirIterator = 0;
+		for (auto &iterator : dirIterators) iterator = DirIterator{};
+		memset(sectorHashEntries, 0, sizeof(sectorHashEntries));
+		memset(&rootEntry, 0, sizeof(rootEntry));
+#endif
+		dataCD = false; iso = false;
+#if !defined(OSFREE)
+		is_joliet = is_udf = is_rock_ridge = false;
+#endif
+		usb_loading = true;
+		try {
+			if (present) {
+				if (CDROM_IsAudioOnly(cdrom)) {
+					strcpy(discLabel, "Audio_CD"); usb_ready = true;
+				} else {
+					usb_ready = loadImage();
+					if (usb_ready) {
+						char label[32] = {};
+						MSCDEX_GetVolumeName(subUnit, label);
+						Set_Label(label, discLabel, true);
+					}
+				}
+			}
+		} catch (...) { usb_loading = false; throw; }
+		usb_loading = false;
+	}
+	if (!present || !usb_ready || USBGeneration() != usb_generation ||
+	    (expected && expected != usb_generation)) {
+		DOS_SetError(DOSERR_DRIVE_NOT_READY); return false;
+	}
+	return true;
+}
+
+char const *isoDrive::GetLabel() {
+	if (!USBReady()) return "";
+	return discLabel;
+}
