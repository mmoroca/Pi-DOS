 #if !defined(OSFREE)
+static uint16_t pidos_copy_chunk(uint16_t source_handle, uint16_t target_handle) {
+#if defined(LINUX)
+    const unsigned int source = RealHandle(source_handle), target = RealHandle(target_handle);
+    if (source < DOS_FILES && target < DOS_FILES && Files[source] && Files[target] &&
+        !(Files[source]->GetInformation() & 0x80) && !(Files[target]->GetInformation() & 0x80)) {
+        const uint8_t drive = Files[target]->GetDrive();
+        if (drive < DOS_DRIVES && Drives[drive] && PI_DOS_IsUSBFloppy(Drives[drive])) {
+            // Fewer DOS write commits; the transport still bounds each USB request.
+            const char *diagnostics = getenv("PI_DOS_DIAGNOSTICS");
+            if (diagnostics && !strcmp(diagnostics, "1"))
+                fprintf(stderr, "Pi-DOS USB floppy COPY: chunk_bytes=%u\n", 0xf000u);
+            return 0xf000; // 60 KiB, sector-aligned and below the 16-bit DOS limit.
+        }
+    }
+#else
+    (void)source_handle;
+    (void)target_handle;
+#endif
+    return 0x8000;
+}
